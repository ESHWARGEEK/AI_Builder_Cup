# ── Enterprise Knowledge Assistant (EKA) Environment Configuration ──

# Google Cloud Project & Region
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# API Server Settings
API_HOST="0.0.0.0"
API_PORT="8080"
ALLOWED_ORIGINS="http://localhost:3000,https://eka-frontend.run.app"

# Engine 1: Vertex AI Search & RAG
VERTEX_SEARCH_DATA_STORE_ID="travel-expense-policies-ds"
VERTEX_SEARCH_SERVING_CONFIG="default_search"
GEMINI_MODEL="gemini-1.5-pro-002"
RAG_SLA_SECONDS=3.0

# Engine 2: Document AI Specialized Invoice Parser
DOCUMENT_AI_LOCATION="us"
DOCUMENT_AI_PROCESSOR_ID="projects/your-gcp-project-id/locations/us/processors/your-invoice-processor-id"
GCS_INGESTION_BUCKET="eka-invoices-your-project"
DOCAI_SLA_SECONDS=15.0

# Engine 3: AlloyDB & Firestore
ALLOYDB_CLUSTER_ID="eka-cluster"
ALLOYDB_INSTANCE_ID="eka-primary"
ALLOYDB_DATABASE_NAME="eka_db"
ALLOYDB_USER="eka_app"
ALLOYDB_PASSWORD="change-me-in-secret-manager"
FIRESTORE_DATABASE="(default)"
FIRESTORE_COLLECTION_INVOICES="invoices"
FIRESTORE_COLLECTION_AUDIT="audit_trail"
FIRESTORE_COLLECTION_SESSIONS="chat_sessions"

# AAL-3 Governance Configuration
AAL3_AUTO_PROCESS_THRESHOLD_USD=1000.00
AAL3_CONFIDENCE_THRESHOLD=0.95
AAL3_ARITHMETIC_TOLERANCE_USD=0.01

# Security & Model Armor
MODEL_ARMOR_ENABLED=true
MODEL_ARMOR_ENDPOINT="modelarmor.googleapis.com"
MODEL_ARMOR_TEMPLATE_ID="eka-ap-firewall-template"

# Frontend Environment Variables (in frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:8080"
